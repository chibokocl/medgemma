# Copy to /etc/medgemma/medgemma.env (systemd) or .env (docker compose).
# Hugging Face token with the MedGemma license accepted (required to download weights).
HF_TOKEN=hf_xxx

# Clients must send:  Authorization: Bearer <MEDGEMMA_API_KEY>
# Generate one with:  openssl rand -hex 32
MEDGEMMA_API_KEY=

MEDGEMMA_HOST=127.0.0.1
MEDGEMMA_PORT=8000
MEDGEMMA_MAX_TOKENS_LIMIT=2048
MEDGEMMA_MAX_IMAGE_MB=10
